# Required: 32+ char random string. openssl rand -hex 32
SESSION_SECRET=

# Required: 64 hex chars (32 bytes). openssl rand -hex 32
UPSTREAM_KEY_KMS=

# Required in production: lock /metrics behind this bearer token.
METRICS_TOKEN=

# Postgres credentials (override defaults if you want)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maplelink

# Upstream Anthropic base URL. For testing: http://127.0.0.1:8000 etc.
ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com

# Public ports nginx listens on. With Cloudflare proxy in front, 443 is what
# CF connects to (Full / Full strict mode); 80 stays open for local healthchecks.
HTTP_PORT=80
HTTPS_PORT=443

# Where the Cloudflare Origin Certificate lives on the host. Must contain
# origin.pem and origin.key. Leave default unless you store certs elsewhere.
CERTS_DIR=./certs

LOG_LEVEL=info
